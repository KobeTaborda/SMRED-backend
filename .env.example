# ============================================================
#  SMRED backend - variables de entorno
#  En local: copia este archivo como .env y cambia los valores.
#  En Render: NO subas el .env; crea estas variables en Environment.
#  El archivo .env está en .gitignore: NUNCA lo subas a GitHub.
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Proxies delante del servidor en producción (Vercel + Render = 2)
TRUST_PROXY_HOPS=1

# Clave para firmar la cookie de sesión (mínimo 32 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esto-por-una-clave-aleatoria-de-64-caracteres
SESSION_TTL_MINUTES=30

# --- Base de datos (SQL Server local o Azure SQL) ---
# Azure SQL: DB_HOST=<tu-servidor>.database.windows.net
DB_HOST=localhost
DB_PORT=1433
DB_NAME=smred
DB_APP_USER=smred_app
DB_APP_PASSWORD=Cambiar-App-2026
# true en local (certificado autofirmado). En Azure SQL: false
DB_TRUST_SERVER_CERT=true
# Crea/actualiza las tablas automáticamente al arrancar
DB_MIGRATE_ON_START=true

# --- Administrador inicial de SMRED (solo si no existe ningún usuario) ---
SMRED_ADMIN_USERNAME=admin
SMRED_ADMIN_PASSWORD=Cambiar-Admin-2026
SMRED_ADMIN_FULLNAME=Administrador SMRED

# --- Monitoreo ---
PING_INTERVAL_SECONDS=30
PING_ATTEMPTS=3
PING_TIMEOUT_MS=2000
PING_DEGRADED_MS=200
PING_RETENTION_DAYS=7
HTTP_TIMEOUT_MS=10000
HTTP_DEGRADED_MS=1000
SSL_WARNING_DAYS=14
